        <rules key="{6016e957-d83c-4b19-83a1-60a4af693439}">
          <rule label="Nature known" key="{0b5266dd-f913-44f9-8ee6-a2936561f8fd}" symbol="0" filter="&quot;NATURE&quot; is not NULL">
            <rule label="Inn" key="{ef4ea24f-c41b-46ee-9466-5010b92f15ec}" symbol="1" filter="&quot;NATURE&quot;='INN' OR &quot;NATURE&quot;='ENTERTAINMENT_VENUE'"/>
            <rule label="Castle" key="{269a72bd-6ae0-4264-839c-b713b2388df6}" symbol="2" filter="&quot;NATURE&quot; = 'CASTLE'"/>
            <rule label="CHapel" key="{dc80e1b7-b282-4d6f-802b-7d06028e0520}" symbol="3" filter="&quot;NATURE&quot; = 'CHAPEL'"/>
            <rule label="Shop, Warehouse" key="{476bf9cc-15ad-4058-b4e2-b52f4eee1254}" symbol="4" filter="&quot;NATURE&quot; = 'SHOP' or &quot;NATURE&quot;='WAREHOUSE'"/>
            <rule label="Farm" key="{41db1c43-36ed-4bba-85ba-82f9e8cc136d}" symbol="5" filter="&quot;NATURE&quot; like 'FARM%'"/>
            <rule label="Living place" key="{2e0f1c06-ae14-48a2-a9f0-b50f72ca916f}" symbol="6" filter="&quot;NATURE&quot; = 'HOUSING'"/>
            <rule label="Monument" key="{dc83c4c3-e047-43d0-97d3-30dd28d3ba32}" symbol="7" filter="&quot;NATURE&quot; = 'MONUMENT'"/>
            <rule label="Mill" key="{818dfaa4-651b-4714-bc2b-1def1f7c6011}" symbol="8" filter="&quot;NATURE&quot; = 'MILL'"/>
            <rule label="Tower" key="{44e8cc8f-8622-4937-8bfc-0d1bde9817da}" symbol="9" filter="&quot;NATURE&quot; = 'TOWER'"/>
            <rule label="Undifferenciated" key="{e16b1d42-b850-4502-8073-c015ac7e9871}" symbol="10" filter="&quot;NATURE&quot; = 'UNDIFF'"/>
            <rule label="ELSE" key="{b1652f9f-50db-4d81-9962-1c90a065c56a}" symbol="11" filter="ELSE"/>
          </rule>
          <rule label="1st use" key="{d1530808-1fcf-4e22-a92a-80c03a0ef692}" symbol="12" filter="&quot;USAGE1&quot; is not null">
            <rule label="Administrative" key="{7d0f2322-1598-4c90-9891-3378ab07a67b}" symbol="13" filter=" &quot;USAGE1&quot; ='ADMIN'"/>
            <rule label="Agricultural" key="{d8a37806-83a7-4f6a-9f1a-e0a171d65810}" symbol="14" filter=" &quot;USAGE1&quot; ='AGRICOLE'"/>
            <rule label="Artisanal" key="{c95e94f3-b1f5-40d9-8454-a29baccdaf7a}" symbol="15" filter=" &quot;USAGE1&quot; ='ARTISANAL'"/>
