        <rules key="{6016e957-d83c-4b19-83a1-60a4af693439}">
          <rule label="Nature known" symbol="0" key="{0b5266dd-f913-44f9-8ee6-a2936561f8fd}" filter="&quot;NATURE&quot; is not NULL">
            <rule label="Inn" symbol="1" key="{ef4ea24f-c41b-46ee-9466-5010b92f15ec}" filter="&quot;NATURE&quot;='INN' OR &quot;NATURE&quot;='ENTERTAINMENT_VENUE'"/>
            <rule label="Castle" symbol="2" key="{269a72bd-6ae0-4264-839c-b713b2388df6}" filter="&quot;NATURE&quot; = 'CASTLE'"/>
            <rule label="CHapel" symbol="3" key="{dc80e1b7-b282-4d6f-802b-7d06028e0520}" filter="&quot;NATURE&quot; = 'CHAPEL'"/>
            <rule label="Shop, Warehouse" symbol="4" key="{476bf9cc-15ad-4058-b4e2-b52f4eee1254}" filter="&quot;NATURE&quot; = 'SHOP' or &quot;NATURE&quot;='WAREHOUSE'"/>
            <rule label="Farm" symbol="5" key="{41db1c43-36ed-4bba-85ba-82f9e8cc136d}" filter="&quot;NATURE&quot; like 'FARM%'"/>
            <rule label="Living place" symbol="6" key="{2e0f1c06-ae14-48a2-a9f0-b50f72ca916f}" filter="&quot;NATURE&quot; = 'HOUSING'"/>
            <rule label="Monument" symbol="7" key="{dc83c4c3-e047-43d0-97d3-30dd28d3ba32}" filter="&quot;NATURE&quot; = 'MONUMENT'"/>
