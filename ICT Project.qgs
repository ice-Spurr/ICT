          <rule key="{0b5266dd-f913-44f9-8ee6-a2936561f8fd}" symbol="0" label="Nature known" filter="&quot;NATURE&quot; is not NULL">
            <rule key="{ef4ea24f-c41b-46ee-9466-5010b92f15ec}" symbol="1" label="Inn" filter="&quot;NATURE&quot;='INN' OR &quot;NATURE&quot;='ENTERTAINMENT_VENUE'"/>
            <rule key="{269a72bd-6ae0-4264-839c-b713b2388df6}" symbol="2" label="Castle" filter="&quot;NATURE&quot; = 'CASTLE'"/>
            <rule key="{dc80e1b7-b282-4d6f-802b-7d06028e0520}" symbol="3" label="CHapel" filter="&quot;NATURE&quot; = 'CHAPEL'"/>
            <rule key="{476bf9cc-15ad-4058-b4e2-b52f4eee1254}" symbol="4" label="Shop, Warehouse" filter="&quot;NATURE&quot; = 'SHOP' or &quot;NATURE&quot;='WAREHOUSE'"/>
            <rule key="{41db1c43-36ed-4bba-85ba-82f9e8cc136d}" symbol="5" label="Farm" filter="&quot;NATURE&quot; like 'FARM%'"/>
            <rule key="{2e0f1c06-ae14-48a2-a9f0-b50f72ca916f}" symbol="6" label="Living place" filter="&quot;NATURE&quot; = 'HOUSING'"/>
            <rule key="{dc83c4c3-e047-43d0-97d3-30dd28d3ba32}" symbol="7" label="Monument" filter="&quot;NATURE&quot; = 'MONUMENT'"/>
            <rule key="{818dfaa4-651b-4714-bc2b-1def1f7c6011}" symbol="8" label="Mill" filter="&quot;NATURE&quot; = 'MILL'"/>
