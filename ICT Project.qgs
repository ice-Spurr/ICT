          <rule key="{0b5266dd-f913-44f9-8ee6-a2936561f8fd}" label="Nature known" symbol="0" filter="&quot;NATURE&quot; is not NULL">
            <rule key="{ef4ea24f-c41b-46ee-9466-5010b92f15ec}" label="Inn" symbol="1" filter="&quot;NATURE&quot;='INN' OR &quot;NATURE&quot;='ENTERTAINMENT_VENUE'"/>
            <rule key="{269a72bd-6ae0-4264-839c-b713b2388df6}" label="Castle" symbol="2" filter="&quot;NATURE&quot; = 'CASTLE'"/>
            <rule key="{dc80e1b7-b282-4d6f-802b-7d06028e0520}" label="CHapel" symbol="3" filter="&quot;NATURE&quot; = 'CHAPEL'"/>
            <rule key="{476bf9cc-15ad-4058-b4e2-b52f4eee1254}" label="Shop, Warehouse" symbol="4" filter="&quot;NATURE&quot; = 'SHOP' or &quot;NATURE&quot;='WAREHOUSE'"/>
            <rule key="{41db1c43-36ed-4bba-85ba-82f9e8cc136d}" label="Farm" symbol="5" filter="&quot;NATURE&quot; like 'FARM%'"/>
            <rule key="{2e0f1c06-ae14-48a2-a9f0-b50f72ca916f}" label="Living place" symbol="6" filter="&quot;NATURE&quot; = 'HOUSING'"/>
            <rule key="{dc83c4c3-e047-43d0-97d3-30dd28d3ba32}" label="Monument" symbol="7" filter="&quot;NATURE&quot; = 'MONUMENT'"/>
            <rule key="{818dfaa4-651b-4714-bc2b-1def1f7c6011}" label="Mill" symbol="8" filter="&quot;NATURE&quot; = 'MILL'"/>
